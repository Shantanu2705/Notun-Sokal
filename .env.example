# Canonical public site URL (used for metadata, Open Graph, sitemap, and robots)
NEXT_PUBLIC_SITE_URL=https://notunsokal.org

# Contact Form Email Delivery (Optional - Resend API)
# Leave blank if email delivery is not yet configured; the UI will inform visitors
# and direct them to the verified phone and email contact options.
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=tenuramroy788@gmail.com
CONTACT_FROM_EMAIL=Notun Sokal Website <onboarding@resend.dev>

# Optional Webhook Forwarding (Alternative to Resend if using a custom mailer)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Optional Upstash Redis for distributed rate limiting in serverless environments
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
